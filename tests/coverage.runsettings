<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Deux formats, deux consommateurs qui ne lisent pas le même (NTR-169) :
               cobertura  — ReportGenerator, le commentaire de pull request, check-coverage.sh
               opencover  — SonarQube Cloud. Son analyseur C# ne lit pas le Cobertura, réservé
                            aux autres langages. Sans ce second format, Sonar afficherait 0 %
                            de couverture sur un projet qui dépasse 90. -->
          <Format>cobertura,opencover</Format>
          <Exclude>[*.Tests]*</Exclude>
          <ExcludeByAttribute>ExcludeFromCodeCoverage</ExcludeByAttribute>
          <ExcludeByFile>**/DTOs/**/*.cs,**/Program.cs,**/DependencyInjection.cs</ExcludeByFile>
          <Thresholds>
            <Coverage Assembly="NutritionApi.Domain" Line="90" Branch="90" />
            <Coverage Assembly="NutritionApi.Application" Line="80" Branch="80" />
            <Coverage Assembly="NutritionApi.Infrastructure" Line="70" Branch="70" />
            <Coverage Assembly="NutritionApi.Api" Line="70" Branch="70" />
          </Thresholds>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
