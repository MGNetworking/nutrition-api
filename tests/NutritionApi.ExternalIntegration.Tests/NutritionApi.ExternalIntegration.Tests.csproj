<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)../coverage.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <!-- Lecteur OpenAPI — absent de Swashbuckle, qui n'embarque que le modèle. C'est lui qui
         permet de valider le document produit avec un vrai parseur, et non de vérifier
         seulement que le JSON est bien formé. Version alignée sur le Microsoft.OpenApi
         transitif de Swashbuckle 7.2.0. -->
    <PackageReference Include="Microsoft.OpenApi.Readers" Version="1.6.22" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure est référencée directement : ce niveau éprouve ses implémentations
         (repositories, cache Redis, supervision Hangfire) contre les vrais composants.
         Npgsql, StackExchange.Redis et Hangfire.PostgreSql arrivent transitivement. -->
    <ProjectReference Include="..\..\src\NutritionApi.Api\NutritionApi.Api.csproj" />
    <ProjectReference Include="..\..\src\NutritionApi.Application\NutritionApi.Application.csproj" />
    <ProjectReference Include="..\..\src\NutritionApi.Domain\NutritionApi.Domain.csproj" />
    <ProjectReference Include="..\..\src\NutritionApi.Infrastructure\NutritionApi.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source de vérité des identités du realm. Copié plutôt que recopié à la main : les comptes,
         leurs identifiants et le secret du service account sont lus depuis l'export lui-même. -->
    <None Include="..\..\keycloak\realm-export.json" Link="realm-export.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
