{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Keycloak": {
    "Authority": "",
    "Audience": "nutrition-api",
    "RequireHttpsMetadata": true,
    "AdminBaseUrl": "",
    "Realm": "",
    "ServiceClientId": "nutrition-api-service",
    "ServiceClientSecret": "",
    "StartupTimeoutSeconds": 60
  },
  "Redis": {
    "ConnectionString": "",
    "SearchCacheTtlHours": 24
  },
  "Hangfire": {
    "DashboardPath": "/hangfire"
  },
  "OpenFoodFacts": {
    "DumpUrl": "https://static.openfoodfacts.org/data/openfoodfacts-products.jsonl.gz",
    "BatchSize": 1000
  },
  "OpenTelemetry": {
    "ServiceName": "nutrition-api",
    "OtlpEndpoint": "",
    "ConsoleExporter": false
  }
}
