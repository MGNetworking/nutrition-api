{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5445;Database=nutrition_dev;Username=postgres;Password=postgres"
  },
  "Keycloak": {
    "Authority": "http://localhost:8778/realms/nutrition",
    "RequireHttpsMetadata": false,
    "AdminBaseUrl": "http://localhost:8778",
    "Realm": "nutrition",
    "ServiceClientSecret": "dev-service-secret"
  },
  "Redis": {
    "ConnectionString": "localhost:6336"
  },
  "OpenTelemetry": {
    "ConsoleExporter": true
  }
}
